	(wire (pts (xy 96.52 88.9) (xy 83.82 88.9)) (stroke (width 0) (type default)) (uuid "3854f535-6f0d-4c02-8dbc-07076fdcef46"))
	(label "ODU_5V" (at 83.82 88.9 0) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "e5f37448-33d3-430b-8114-87ed1e4cdee7"))
	(wire (pts (xy 96.52 91.44000000000001) (xy 83.82 91.44000000000001)) (stroke (width 0) (type default)) (uuid "9b246614-863c-4a23-947a-09adb7d2747e"))
	(label "XIAO_5V" (at 83.82 91.44000000000001 0) (effects (font (size 1.27 1.27)) (justify right bottom)) (uuid "eaf232ef-04b2-4cab-bb59-d9cd9bf2a700"))
	(text "fit the shunt to power the XIAO from the ODU" (exclude_from_sim no) (at 104.14 87.9 0) (effects (font (size 1.0 1.0)) (justify left)) (uuid "1a913623-1c1b-4f7d-a52f-71fb55b03345"))
	(text "J1 taps the ODU diagnostic port; the ESP32 reads the CLK / DAT bus through the level shifter." (exclude_from_sim no) (at 43.18 102.87 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "3ad01538-b623-4bf5-adf7-59eca831717b"))
	(text "The 5V bus (CLK / DAT) is level-shifted to 3V3. The ODU supplies the 5V HV reference; the XIAO" (exclude_from_sim no) (at 43.18 113.03 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "61ff0a3a-cdfd-4470-a134-a91b3a9df79f"))
	(text "supplies the 3V3 LV reference." (exclude_from_sim no) (at 43.18 118.11 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "93ca66b6-2072-468d-8f4f-88c76f239847"))
	(text "" (exclude_from_sim no) (at 43.18 123.19 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "933780f5-70b1-4d62-a9a2-edea57d4ad4a"))
	(text "J5 is an OPTIONAL jumper that ties the ODU's 5V to the XIAO's 5V pin so the board runs without USB." (exclude_from_sim no) (at 43.18 128.27 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "bf3712d1-e4ae-4c5e-825d-bf0b1a82b3f9"))
	(text "Leave it OPEN whenever USB-C is connected - fitting it back-feeds the host's VBUS from the ODU." (exclude_from_sim no) (at 43.18 133.35 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "1aba8541-5818-4f93-ad72-0bfdda201928"))
	(text "" (exclude_from_sim no) (at 43.18 138.43 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "3d64498b-e9a2-4c4d-9519-1cc82d959dbc"))
	(text "Firmware pin mapping:  PIN_CLK = D2 (GPIO3),  PIN_DAT = D1 (GPIO2)." (exclude_from_sim no) (at 43.18 143.51 0) (effects (font (size 1.27 1.27)) (justify left)) (uuid "d11fe48c-9c0b-4d65-8fde-9bd9c9f96046"))

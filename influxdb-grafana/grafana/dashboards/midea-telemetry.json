      "gridPos": { "h": 6, "w": 3, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "#8e9099", "value": null },
              { "color": "blue", "value": 1 },
              { "color": "orange", "value": 2 },
              { "color": "green", "value": 3 },
              { "color": "purple", "value": 4 },
              { "color": "#6e7079", "value": 5 },
              { "color": "dark-blue", "value": 6 },
              { "color": "light-blue", "value": 7 }
